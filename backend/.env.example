# Copy to .env and run: createdb stellarmarket (if needed). Requires PostgreSQL running locally.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellarmarket?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-this"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Required for local dev: without this, CORS silently rejects every request
# from the frontend (the "any localhost origin is allowed" rule below only
# applies when NODE_ENV is exactly "development" or "test") — the frontend
# fails with a generic "Failed to fetch" and no other clue why.
NODE_ENV=development

# Comma-separated list of allowed CORS origins (production)
# In development/test, localhost with any port is automatically allowed
CORS_ALLOWED_ORIGINS="https://stellarmarket.io,https://www.stellarmarket.io"

# Job posting and private dispute evidence storage
PLATFORM_MIN_BUDGET_XLM=1
EVIDENCE_S3_BUCKET=""
EVIDENCE_S3_REGION="us-east-1"
# Optional S3-compatible endpoint (for MinIO/R2); leave blank for AWS S3.
EVIDENCE_S3_ENDPOINT=""
EVIDENCE_S3_FORCE_PATH_STYLE=false

# Optional: override default upload directory (default: backend/uploads)
UPLOAD_DIR="./uploads"
# Optional: avatar storage (default: UPLOAD_DIR/avatars). Set to a path for local storage.
AVATAR_UPLOAD_DIR="./uploads/avatars"
# Redis Configuration for caching
REDIS_URL="redis://localhost:6379"

# SMTP Configuration for email sending (used when EMAIL_SERVICE_PROVIDER is unset or "smtp")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="StellarMarket <noreply@stellarmarket.com>"

# Set EMAIL_SERVICE_PROVIDER="brevo" to send via Brevo's HTTP API instead of SMTP
# (no SMTP login needed, just an API key). The from address must be a verified
# sender in that Brevo account or every send will be rejected.
EMAIL_SERVICE_PROVIDER="smtp"
EMAIL_SERVICE_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@stellarmarket.io"
EMAIL_FROM_NAME="StellarMarket"

# Stellar / Soroban configuration
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
ESCROW_CONTRACT_ID=""
DISPUTE_CONTRACT_ID=""
REPUTATION_CONTRACT_ID=""
# Required: 56-character Stellar contract address (C-strkey) for the native token.
# On testnet this is the SAC for XLM. Server will not start without a valid value.
NATIVE_TOKEN_ID=""

# Web Push Notifications (VAPID keys)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@stellarmarket.io"
